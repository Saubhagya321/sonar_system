# =============================================================================
# Retraining Orchestrator (main_orchestrator.py)
#
# Unlike lightgcn_scripts' serving image, the orchestrator does not run its
# own API — main_orchestrator.py dynamically loads and executes
# lightgcn_scripts/orchestrator.py, collabrative_filter_scripts/orchestrator.py
# and comnbiner_script_final/grid_search.py as Python modules IN THIS SAME
# PROCESS (see _load_module()/_syspath() in main_orchestrator.py). So this
# image bundles all four folders' source code and the union of their
# dependencies, instead of just one service.
# =============================================================================
FROM python:3.11.9-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# -----------------------------------------------------------------------------
# System dependencies + Microsoft ODBC Driver 17 for SQL Server (required by
# pyodbc / the mssql+pyodbc connection strings used across these folders)
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ca-certificates \
        gnupg \
        unixodbc \
        unixodbc-dev \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -sSL https://packages.microsoft.com/config/debian/12/prod.list -o /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql17 \
    && apt-get purge -y --auto-remove gnupg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Python dependencies — CPU-only torch, installed before the union
# requirements file so pip resolves the folders' torch>=... constraints
# against the already-installed CPU wheel instead of the CUDA default.
# -----------------------------------------------------------------------------
COPY orchestrator-requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r orchestrator-requirements.txt

# -----------------------------------------------------------------------------
# Application code — every folder main_orchestrator.py dynamically imports.
# Runtime data (centralized_data/, staging/, models/, output/, .env files)
# is volume-mounted at container run time — see docker-compose.yml.
# -----------------------------------------------------------------------------
COPY retraining_pipeline/ retraining_pipeline/
COPY lightgcn_scripts/ lightgcn_scripts/
COPY collabrative_filter_scripts/ collabrative_filter_scripts/
COPY comnbiner_script_final/ comnbiner_script_final/

RUN mkdir -p \
        centralized_data \
        staging \
        retraining_pipeline/logs \
        lightgcn_scripts/data lightgcn_scripts/models lightgcn_scripts/output lightgcn_scripts/pipeline_data \
        collabrative_filter_scripts/data collabrative_filter_scripts/output \
        comnbiner_script_final/data comnbiner_script_final/weights comnbiner_script_final/logs

RUN useradd --create-home --uid 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

WORKDIR /app/retraining_pipeline

# ENTRYPOINT fixed to the orchestrator script; append args at `docker run`
# time, e.g.:  docker run <image> --run-now  /  --status  /  --rollback 2026_06
ENTRYPOINT ["python", "main_orchestrator.py"]
CMD ["--status"]
